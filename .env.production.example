# ==============================================================================
# BT-SmartDry Production Environment Configuration (.env.production)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# In Supabase dashboard: Project Settings -> Database -> Connection string -> URI
# Use the connection pooler URI on port 6543 (transaction mode) with sslmode=require
# Format for asyncpg: postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:yoursecurepassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?ssl=require

# ------------------------------------------------------------------------------
# 2. Application & Environment Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PROJECT_NAME="BT-SmartDry API"
VERSION=1.0.0

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64-character secret key:
# openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 4. CORS Origins (Whitelist your Render frontend URL)
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://bt-smartdry-frontend.onrender.com,https://btsmartdry.dekut.ac.ke

# ------------------------------------------------------------------------------
# 5. Africa's Talking SMS Subsystem
# ------------------------------------------------------------------------------
# SMS_PROVIDER_MODE options:
#   - mock: zero-cost local test mode; logs to stdout and DB without network call
#   - sandbox: connects to Africa's Talking Sandbox API (username: sandbox)
#   - live: connects to live cellular cellular network with KES 500 airtime credit
SMS_PROVIDER_MODE=sandbox

# Sandbox credentials:
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=atsk_sandbox_your_sandbox_api_key_here
AFRICASTALKING_SENDER_ID=BTSmartDry

# Live production credentials (uncomment and populate for live cellular broadcast):
# AFRICASTALKING_USERNAME=btsmartdry_live
# AFRICASTALKING_API_KEY=atsk_live_your_production_api_key_here
# AFRICASTALKING_SENDER_ID=BTSmartDry

# ------------------------------------------------------------------------------
# 6. Dryer Physics & Business Constraints
# ------------------------------------------------------------------------------
MAX_DRYER_CAPACITY_KG=200.0

# ------------------------------------------------------------------------------
# 7. Frontend Environment Variables (.env.production in frontend directory)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=https://bt-smartdry-backend.onrender.com

