# Database (Supabase PostgreSQL / Local Docker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/btsmartdry

# Security & Auth
SECRET_KEY=dev_secret_key_change_in_production_min_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Africa's Talking SMS API
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=atsk_sandbox_dummy_key_for_dev
AFRICASTALKING_SENDER_ID=BTSmartDry

# Environment & CORS
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Telemetry Simulator
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_BACKEND_URL=http://localhost:8000

